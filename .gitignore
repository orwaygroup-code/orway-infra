# Secretos — NUNCA commitear
.env
**/.env
*.env.local

# TLS de Traefik
acme/
acme.json

# Datos locales si se montan como bind
data/
backups/*.sql
backups/*.gz

# Estado de los clientes de ORest en el host (lo escriben el script de alta y el agente de ORest
# Cloud): .env con secretos, sus copias apartadas (.env.apartado-<fecha>) y los temporales de la
# escritura atómica (.env.tmp-…). `**/.env` solo tapa el nombre exacto.
apps/orest/clients/
**/.env.*
!**/.env.example
