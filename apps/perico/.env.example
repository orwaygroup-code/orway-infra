# El Perico — POS. Copiar a .env y rellenar. NO commitear el .env real.
# En el VPS: chmod 600 .env
#
# Los secretos reales los genera scripts/new-perico.sh; este archivo es la
# referencia de qué variables existen y por qué.

# --- Identidad de la instancia (las usa Traefik en las labels) -------------
DOMAIN=perico.orwaygroup.com

# --- Base de datos ---------------------------------------------------------
# DOS roles a propósito, como Orway System:
#
#   perico_owner  dueño de la BD. Corre migraciones. Puede alterar estructura.
#   perico_app    runtime de la app. Lee y escribe datos, NUNCA cambia
#                 estructura. Una inyección SQL en la app no puede DROP TABLE
#                 sobre los cortes de caja.
#
# Host `postgres` = nombre del servicio en la red interna del VPS. Nunca
# localhost, y Postgres no se expone a internet.
DATABASE_URL=postgresql://perico_owner:cambia-esto@postgres:5432/perico_db?schema=public
DATABASE_URL_APP=postgresql://perico_app:cambia-esto@postgres:5432/perico_db?schema=public

# --- Sesión del personal ---------------------------------------------------
# Firma la cookie de sesión del login por PIN. >=32 chars.
# Genera: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-un-secreto-largo-de-32+

# --- PrintBridge -----------------------------------------------------------
# Clave compartida con el puente de impresión que corre en la PC de la caja
# (header x-print-key). Es la única credencial que vive fuera del VPS, en una
# computadora del local: tratarla como comprometible y rotarla si esa PC se
# cambia, se vende o se va un empleado con acceso.
# Genera: openssl rand -hex 32
PRINT_BRIDGE_KEY=cambia-esta-clave

# --- Operación -------------------------------------------------------------
TZ=America/Mexico_City
BUSINESS_NAME=El Perico

# Personal inicial que crea el seed. El PIN se rota en la primera entrega.
SEED_OWNER_NAME=Dueno
SEED_OWNER_PIN=cambia-esto

# El super-admin interno de Orway (rol ORWAY). No se le entrega al cliente.
SEED_ORWAY_NAME=Orway
SEED_ORWAY_PIN=cambia-esto

# --- Lo que este proyecto NO usa ------------------------------------------
# n8n:     no hay bot en la Fase 1. No se conecta, no se le abre superficie.
# Meta:    sin WhatsApp en Fase 1.
# PAC:     la facturación CFDI es Fase 3. Cuando llegue, el CSD va montado
#          como secreto de archivo, no como variable de entorno.
