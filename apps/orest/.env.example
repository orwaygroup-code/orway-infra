# ORest — .env de UNA instancia (un restaurante).
# Lo genera scripts/new-orest-client.sh. Esta copia es la REFERENCIA de TODO lo que la app lee
# (verificado contra process.env.* del código, 29 oct 2026).

# ── Identidad de la instancia ──────────────────────────────────────────────────
# CLIENT prefija el proyecto Compose y el router de Traefik; DOMAIN es el subdominio del
# restaurante, con su A (comodín *) apuntando al VPS.
CLIENT=
DOMAIN=

# Etiqueta de la imagen orest:<IMAGE_TAG>. OBLIGATORIA: debe corresponder a un commit (regla del
# ensayo del 10 oct). Sin ella el compose caería a `latest`.
IMAGE_TAG=

# ── Base de datos (OBLIGATORIA) ────────────────────────────────────────────────
# Base propia del restaurante, en el Postgres compartido (host `postgres`). El connection_limit=5
# va EXPLÍCITO: si falta, Prisma lo deriva de los núcleos del host.
DATABASE_URL=postgresql://orest_<cliente>:<password>@postgres:5432/orest_<cliente>_db?schema=public&connection_limit=5

# ── Secretos OBLIGATORIOS ──────────────────────────────────────────────────────
# HMAC de las cookies de sesión. Sin él la app ABORTA (lib/authSecret.ts). No se regenera sin tirar
# todas las sesiones abiertas.  Genera: openssl rand -base64 48
AUTH_SECRET=

# Llave maestra que CIFRA los secretos guardados (credenciales de Mercado Pago, etc.). En producción,
# sellar o abrir un secreto SIN esta llave LANZA (lib/secretBox.ts): guardar una credencial de MP
# truena. 64 hex se usan tal cual.  Genera: openssl rand -hex 32
SECRETS_KEY=

# ── Plan de la instancia ───────────────────────────────────────────────────────
# esencial | profesional | concierge. FALLA HACIA ABAJO: ausente o mal escrito → `esencial`
# (lib/plan.ts). Ponlo en lo que se vendió; olvidarlo entrega el plan más bajo.
OREST_PLAN=esencial

# ── Arranque / primer uso ──────────────────────────────────────────────────────
# Con la base VACÍA, /primer-uso crea al primer MANAGER si quien lo usa da este código (mínimo 16
# chars; menos → arranque deshabilitado). Deja de servir en cuanto existe cualquier Staff.
# Genera: openssl rand -hex 16
SETUP_CODE=

# Camino ALTERNO de enlace que inyecta ORest Cloud (sha256 hex de 64). En un alta MANUAL no se usa;
# lo planta Cloud al aprovisionar.
# CLAIM_HASH=

# ── IA (OpenAI) — concierge, autoauditoría, transcripción y visión ─────────────
# Sin la llave, esas funciones quedan apagadas. Es la llave de Orway (la IA se factura aparte,
# medida). Los *_MODEL son opcionales: sin ellos usa los default.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_TRANSCRIBE_MODEL=
# OPENAI_VISION_MODEL=

# ── Avisos push (Web Push / VAPID) — recomendado ───────────────────────────────
# Sin estas tres, los avisos push (caja, cocina, gerencia) quedan apagados.
# Genera el par:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@orest.com.mx

# ── Autoauditoría por WhatsApp (solo Concierge) ────────────────────────────────
# Número destino del resumen diario. Sin él, el resumen llega por push, no por WhatsApp.
# OREST_AUDIT_WHATSAPP=

# ── Correo de solicitudes ARCO (privacidad) ────────────────────────────────────
# Sin esto, las solicitudes ARCO no mandan correo (lib/arcoEmail.ts).
# RESEND_API_KEY=
# MAIL_FROM=

# ── Operación ──────────────────────────────────────────────────────────────────
# INTERRUPTOR DE OPERACIÓN (no de pruebas): `off` apaga el descuento automático de inventario durante
# un incidente, sin desplegar código. Déjalo SIN poner (default: encendido).
# STOCK_ENGINE=off
