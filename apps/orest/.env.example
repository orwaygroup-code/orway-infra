# ORest — .env de UNA instancia (un restaurante).
# Lo genera scripts/new-orest-client.sh. Esta copia es la referencia.

# Identidad de la instancia. CLIENT prefija el proyecto Compose y el router de
# Traefik; DOMAIN es el subdominio del restaurante, con su A apuntando al VPS.
CLIENT=
DOMAIN=

# Base propia del restaurante, en el Postgres compartido (host `postgres`).
# connection_limit=5 va EXPLÍCITO: si falta, Prisma lo deriva del número de
# núcleos del host, y el mismo contenedor tendría otro límite de aperturas
# simultáneas al moverlo de máquina (docs/despliegue.md §3 del repo ORest).
DATABASE_URL=postgresql://orest_<cliente>:<password>@postgres:5432/orest_<cliente>_db?schema=public&connection_limit=5

# Secreto HMAC de las cookies de sesión. Obligatorio: lib/authSecret.ts aborta sin él.
AUTH_SECRET=

# Código de arranque. Con la base VACÍA, el asistente de /primer-uso crea al
# primer MANAGER si quien lo usa da este código. Se le entrega a quien pagó.
# Deja de servir en cuanto existe cualquier Staff. Sin él, el arranque da 503.
SETUP_CODE=

# INTERRUPTOR DE OPERACIÓN (no de pruebas): `off` apaga el descuento automático
# de inventario durante un incidente, sin desplegar código. Lo pendiente se
# acumula en la base y se descuenta al volver a prenderlo.
# STOCK_ENGINE=off
